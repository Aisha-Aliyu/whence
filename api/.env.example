# Copy this file to api/.env for local development. Never commit .env.
DATABASE_URL=postgresql://user:password@localhost:5432/whence
SUPABASE_URL=https://your-project.supabase.co
# From the Cloudflare dashboard: your Account ID, and an API token with Workers AI permission.
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
